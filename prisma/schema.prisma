generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MiscEarningSource {
  manual
  q1_adjustment
}

enum CurrencyCode {
  CHF
  EUR
  MXN
}

model Student {
  id         String    @id @default(cuid())
  name       String    @unique
  subject    String
  ratePerMin Decimal @db.Decimal(6, 4)
  currency   String    @default("CHF")
  email      String?
  active     Boolean   @default(true)
  /// Familienrechnung: Lektionen dieses Schülers landen auf der Rechnung des verlinkten Schülers.
  billedToId String?
  billedTo   Student?  @relation("BillingGroup", fields: [billedToId], references: [id])
  billingChildren Student[] @relation("BillingGroup")
  sessions       Session[]
  invoices       Invoice[]
  subscriptions  PlatformSubscription[]
  rateHistory    StudentRateHistory[]
  createdAt      DateTime  @default(now())

  @@index([active, name])
}

/// Tarif-Verlauf: welcher CHF/Min-Satz galt ab welchem Datum.
/// Sync bepreist neue Lektionen mit dem Satz, der am Lektionsdatum galt.
model StudentRateHistory {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  ratePerMin    Decimal @db.Decimal(6, 4)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([studentId, effectiveFrom])
}

model Session {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        DateTime
  durationMin Int
  amountCHF   Decimal @db.Decimal(10, 2)
  calEventId  String?  @unique
  month       Int
  year        Int
  notes       String?
  /// Kalendereintrag nachweislich geloescht — die Lektion wartet auf Bestaetigung.
  /// Der Sync loescht sie nicht mehr selbst; bis zur Entscheidung zaehlt sie
  /// weiter zum Betrag, damit sich ohne Zutun keine Summe bewegt. Taucht der
  /// Termin wieder auf, hebt der Upsert die Vormerkung auf.
  pendingDeletionAt DateTime?
  createdAt   DateTime @default(now())

  @@index([year, month, date])
  @@index([studentId, year, month])
}

model Invoice {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  month         Int
  year          Int
  totalCHF      Decimal @db.Decimal(10, 2)
  sessionIds    String
  invoiceNumber String    @default("")
  /// Nummer vor der einmaligen Duplikat-Reparatur (P2b); null = nie umnummeriert.
  legacyInvoiceNumber String?
  sentAt        DateTime?
  reminderSentAt DateTime?
  /// Zuletzt versendete Mahnstufe: 0 = keine, 1/2 = Erinnerung, 3 = Mahnung
  reminderStage Int       @default(0)
  paidAt        DateTime?
  pdfPath       String?
  /// Letzter PDF-Download durch den Nutzer (jeder Download aktualisiert dies).
  downloadedAt  DateTime?
  /// Erster Download — ab hier gilt die Rechnung als ausgeliefert und unveränderlich.
  firstDownloadedAt DateTime?
  /// Sync hat nach dem ersten Download Abweichungen erkannt und wartet auf Entscheid.
  needsReview   Boolean   @default(false)
  /// Zeitpunkt, zu dem der Nutzer die erkannte Abweichung entschieden hat.
  reviewedAt    DateTime?
  /// Zeitpunkt, zu dem der Sync die Abweichung erkannt hat.
  changeDetectedAt DateTime?
  /// Ausgabestand; jede Neuausstellung unter gleicher Nummer erhöht ihn (P6).
  revision      Int       @default(1)
  /// Storniert: die Rechnung ist gegenstandslos, bleibt aber samt Nummer und PDF
  /// bestehen. Zählt danach weder als Ertrag noch als offene Forderung. Bewusst
  /// ein eigenes Feld: "offen" wird an vier Stellen als sentAt && !paidAt
  /// berechnet, und ein Storno nur im Audit-Log wäre dort nicht sichtbar.
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, month, year])
  @@index([year, month, createdAt])
  @@index([studentId, year, month])
  @@index([needsReview])
}

/// Rechnungsnummern-Zähler pro Jahr. Die Vergabe läuft über ein einziges
/// INSERT ... ON CONFLICT DO UPDATE ... RETURNING, das PostgreSQL zeilenweise
/// sperrt — deshalb können parallele Requests nie dieselbe Nummer erhalten.
/// Ersetzt das frühere max(invoiceNumber)+1, das genau das zuliess.
model InvoiceNumberSequence {
  year       Int      @id
  /// Zuletzt vergebene laufende Nummer dieses Jahres (0 = noch keine).
  lastNumber Int
  updatedAt  DateTime @updatedAt
}

/// Eingefrorener Rechnungsstand pro Revision — geschrieben beim ersten Download (P4)
/// und bei jeder Neuausstellung (P6). Bewusst OHNE Fremdschlüssel auf Invoice:
/// Rechnungszeilen werden heute gelöscht (invoice-stale.ts), der Nachweis muss das überleben.
model InvoiceSnapshot {
  id            String   @id @default(cuid())
  invoiceId     String
  revision      Int
  invoiceNumber String
  totalCHF      Decimal @db.Decimal(10, 2)
  /// Vollständiger InvoicePayload zum Zeitpunkt des Einfrierens (Positionen, Beträge, Schüler).
  payloadJson   Json
  /// Storage-Pfad der zu dieser Revision ausgelieferten PDF.
  pdfPath       String?
  createdAt     DateTime @default(now())

  @@unique([invoiceId, revision])
  @@index([invoiceId, createdAt])
}

/// Lückenloser Änderungsnachweis. Ebenfalls ohne Fremdschlüssel, damit Einträge
/// das Löschen einer Rechnung überdauern.
model InvoiceAuditLog {
  id         String   @id @default(cuid())
  invoiceId  String
  /// z. B. "created", "number_assigned", "downloaded", "change_detected",
  /// "reviewed", "revised", "renumbered", "status_changed", "deleted"
  action     String
  /// E-Mail des angemeldeten Nutzers, oder "system" für automatische Vorgänge.
  actor      String?
  beforeJson Json?
  afterJson  Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([action, createdAt])
}

model TutorProfile {
  id        String   @id @default("default")
  name      String   @default("Max Mustermann")
  email     String   @default("max@example.ch")
  address   String   @default("Musterstrasse 1, 8000 Zürich")
  phone     String   @default("+41 79 000 00 00")
  iban      String   @default("CH00 0000 0000 0000 0000 0")
  bankName  String   @default("Zürcher Kantonalbank")
  /// Jahr für manuelle Q1-Summen (Jan.–Mär.); nur für dieses Jahr
  manualQ1Year   Int?
  /// CHF; wenn alle drei null, gelten die Defaults aus lib/manual-revenue
  manualQ1M1Chf  Decimal? @db.Decimal(10, 2)
  manualQ1M2Chf  Decimal? @db.Decimal(10, 2)
  manualQ1M3Chf  Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSubscription {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  amountCHF      Decimal @db.Decimal(10, 2)
  billingMethod  String           // "invoice" | "direct"
  durationMonths Int              // 1 or 6
  startMonth     Int              // 1–12
  startYear      Int
  active         Boolean          @default(true)
  charges        PlatformCharge[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([studentId, createdAt])
  @@index([active, createdAt])
}

model PlatformCharge {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   PlatformSubscription @relation(fields: [subscriptionId], references: [id])
  month          Int
  year           Int
  amountCHF      Decimal @db.Decimal(10, 2)
  paidAt         DateTime?
  createdAt      DateTime             @default(now())

  @@unique([subscriptionId, month, year])
}

model MiscEarning {
  id        String            @id @default(cuid())
  year      Int
  month     Int
  amountCHF Decimal @db.Decimal(10, 2)
  label     String?
  source    MiscEarningSource @default(manual)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([year, month, source])
}

model Tutor24Contact {
  id         String   @id @default(cuid())
  tutor24Id  String   @unique
  name       String
  profileUrl String?
  messagedAt DateTime @default(now())
}

enum AcademigoContactType {
  teacher
  student
}

model AcademigoSettings {
  id                     String   @id @default("default")
  messageTemplate        String   @db.Text
  messageTemplateStudent String?  @db.Text
  updatedAt              DateTime @updatedAt
}

/// Mahnwesen: drei bearbeitbare Erinnerungs-Vorlagen (Singleton, id = "default").
model ReminderTemplate {
  id        String   @id @default("default")
  stage1    String   @db.Text
  stage2    String   @db.Text
  stage3    String   @db.Text
  updatedAt DateTime @updatedAt
}

model AcademigoContact {
  id          String               @id @default(cuid())
  tutor24Id   String
  contactType AcademigoContactType
  name        String
  profileUrl  String?
  messagedAt  DateTime             @default(now())

  @@unique([tutor24Id, contactType])
}

model FxRateSnapshot {
  id         String   @id @default("default")
  chfPerEur  Decimal @db.Decimal(12, 6)
  chfPerMxn  Decimal @db.Decimal(12, 6)
  source     String?
  fetchedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DanceEarning {
  id             String       @id @default(cuid())
  date           DateTime
  payerName      String
  amountOriginal Decimal @db.Decimal(10, 2)
  currency       CurrencyCode
  chfRate        Decimal @db.Decimal(12, 6)
  amountCHF      Decimal @db.Decimal(10, 2)
  year           Int
  month          Int
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([year, month, date])
}

model AdditionalEarning {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  name      String
  amountCHF Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, month])
}

model MonthlyExpense {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amountCHF Decimal @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}
